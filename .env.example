# ─────────────────────────────────────────────────────────────
# 춘천 꼬마 3D 메이커 · 환경 변수 예시
# 로컬: 이 파일을 .env.local 로 복사해 값을 넣고 서버를 다시 시작
# 배포: Vercel → Project → Settings → Environment Variables 에 같은 이름으로 입력
# (Supabase 값이 비어 있으면 '로컬 테스트 모드'로 동작합니다)
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 비밀 키: 서버에서만 사용. 절대 앞에 NEXT_PUBLIC_ 를 붙이지 마세요.
SUPABASE_SECRET_KEY=

# (선택) 선생님 가입 코드. 정해 두면 이 코드를 아는 사람만 선생님으로 가입할 수 있어요.
TEACHER_SIGNUP_CODE=

# 그림판 'AI에게 그려 달라고 하기' (Google AI Studio 키, 결제 등록 필요)
GEMINI_API_KEY=
# (선택) 기본 gemini-nano-banana-2.1 / 더 빠르게: gemini-3.1-flash-lite-image (가격 같음)
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
